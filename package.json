{
  "name": "astro-sheet-loader-project",
  "private": true,
  "type": "module",
  "scripts": {
    "build:packages": "pnpm --filter astro-sheet-loader build",
    "build:demo": "pnpm --filter demo build",
    "build": "pnpm build:packages && pnpm build:demo",
    "dev": "pnpm --filter demo dev",
    "preview": "pnpm --filter demo preview",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "pnpm build:packages && vp test",
    "test:online": "pnpm build && TEST_ONLINE=1 vp test",
    "pack": "pnpm --filter astro-sheet-loader pack"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "astro": "^7.4.4",
    "astro-sheet-loader": "workspace:*",
    "typescript": "^5.9.3",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@12.15.0"
}
